{
  "name": "media-aggregator",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run && node --test tests/restore-cli.test.mjs",
    "test:dashboard": "vitest run --config dashboard/vitest.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:dashboard": "tsc --noEmit --project dashboard/tsconfig.json",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "build": "npm run build:dashboard && wrangler deploy --dry-run --outdir dist --env \"\"",
    "restore:export": "node --experimental-strip-types scripts/restore-export.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "hono": "^4.13.18",
    "ipaddr.js": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261116.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sax": "^1.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true
  }
}
